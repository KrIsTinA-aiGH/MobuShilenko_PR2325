<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Синий градиентный фон -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#4A90E2"
                android:centerColor="#5B9BD5"
                android:endColor="#7CB9E8"
                android:type="linear" />
        </shape>
    </item>
    <!-- Логотип по центру -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/i5" />
    </item>
</layer-list>